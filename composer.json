{
    "name": "metaseller/tinkoff-invest-api-v2-php",
    "version": "0.6.0",
    "description": "Unofficial PHP SDK for T-Invest API v2",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "php",
        "tinkoff",
        "t-invest",
        "T-Invest API PHP SDK",
        "t-investments",
        "invest api sdk"
    ],
    "homepage": "https://github.com/metaseller/tinkoff-invest-api-v2-php",
    "authors": [
        {
            "name": "Igor Frolenkov",
            "email": "igor@frolenkov.ru"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5.12",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-grpc": "^1.83.1",
        "ext-json": "*",
        "google/protobuf": "^5.36.2",
        "grpc/grpc": "^1.82"
    },
    "autoload": {
        "psr-4": {
            "GPBMetadata\\": "src/models/GPBMetadata",
            "Google\\": "src/models/Google",
            "Tinkoff\\": "src/models/Tinkoff",
            "Metaseller\\TinkoffInvestApi2\\": "src",
            "Metaseller\\TinkoffInvestApi2\\providers\\": "src/providers",
            "Metaseller\\TinkoffInvestApi2\\exceptions\\": "src/exceptions",
            "Metaseller\\TinkoffInvestApi2\\helpers\\": "src/helpers",
            "Metaseller\\TinkoffInvestApi2\\dto\\": "src/dto"
        }
    },
    "require-dev": {
        "rector/rector": "^2.7"
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php -d error_reporting=E_ALL tests/compatibility.php",
            "@php -d error_reporting=E_ALL tests/regressions.php"
        ]
    }
}
